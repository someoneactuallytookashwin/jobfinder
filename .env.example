# Copy this file to ".env" and fill in any values you need.
# The real .env is gitignored. The pipeline runs fully locally against Ollama
# and does not require any API keys by default — this file exists so you have a
# place to put machine-specific overrides if you add them later.

# Example: override the Ollama server location if it isn't on localhost.
# OLLAMA_BASE_URL=http://localhost:11434
